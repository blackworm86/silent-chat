  "narrative": {
    "northStar": "The Lamp in the Dark Room",
    "overview": "Silent Chat is used on a phone, in a dim room, in near silence. Cool ink-blue neutrals recede; one warm lamp-gold accent marks the single thing to act on.",
    "keyCharacteristics": [
      "Dark only; no light theme.",
      "One accent. Blue means me, red means safety, green means online or done.",
      "Tonal layering instead of shadows.",
      "Large touch targets, one-handed use.",
      "Serif for voice, sans for function."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "The gold accent marks the single thing to act on or look at. If two things on a screen are gold, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Blue Is Me Rule",
        "body": "Blue never leaves the chat. It belongs to the author's own messages.",
        "section": "colors"
      },
      {
        "name": "The Red Is Safety Rule",
        "body": "Red is reserved for the X card, lines, warnings and destructive actions. The X button is always red.",
        "section": "colors"
      },
      {
        "name": "The Serif Is a Voice Rule",
        "body": "Fraunces is for names and titles only, never for buttons, labels or chat messages.",
        "section": "typography"
      },
      {
        "name": "The Tone Not Shadow Rule",
        "body": "Raise a surface by making it lighter, not by adding a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep a screen to one gold element.",
      "Do keep the page from scrolling on a phone: fold, tab or strip content.",
      "Do keep touch targets at 44px or more.",
      "Do keep body text at or above 4.5:1 contrast.",
      "Do keep the X button visible and red on every game screen.",
      "Do keep copy ready for Italian and English lengths.",
      "Do respect reduced motion."
    ],
    "donts": [
      "Don't use a light theme or pure black and white.",
      "Don't use gold for decoration, or blue/red/green outside their roles.",
      "Don't add thick one-sided coloured borders or nest cards in cards.",
      "Don't use emoji or Unicode symbols as icons.",
      "Don't use shadows to raise ordinary surfaces.",
      "Don't put the serif on buttons, labels or message text.",
      "Don't hide or move the safety controls."
    ]
  }
}