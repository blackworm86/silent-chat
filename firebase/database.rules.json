{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6,10}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{6,10}$/)",
        "meta": { ".validate": "newData.hasChildren(['epoch', 'hb'])" },
        "q": { "$id": { ".validate": "newData.hasChildren(['d', 'm']) && newData.child('m').isString() && newData.child('m').val().length < 3000000" } },
        "to": { "$dev": { "$id": { ".validate": "newData.isString() && newData.val().length < 3000000" } } },
        "snap": { ".validate": "newData.isString() && newData.val().length < 3000000" },
        "vm": { "$seat": { ".validate": "newData.isString() && newData.val().length < 3000000" } },
        "$other": { ".validate": false }
      }
    }
  }
}
