{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "noEmit": true, "isolatedModules": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "relay", "tools/*.ts"],
  "exclude": ["worker", "node_modules", "dist"]
}
